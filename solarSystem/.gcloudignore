# ========================================
# .gcloudignore
# 指定上传到 Google Cloud 时要忽略的文件
# ========================================

# Git 相关
.git
.gitignore

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# 环境变量
.env
.env.*
!.env.example

# 数据库
*.db
*.sqlite

# 构建产物（Cloud Build 会重新构建）
dist/
build/

# 测试和开发文件
test/
tests/
__tests__/
*.test.js
*.spec.js
test-*.js
coverage/

# 文档
*.md
!README.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 日志
logs/
*.log

# 临时文件
tmp/
temp/

# OS
.DS_Store
Thumbs.db

# 配置文件（开发用）
.prettierrc
.eslintrc*
jsconfig.json

# Docker
Dockerfile.dev
docker-compose.yml
.dockerignore

# Examples
examples/
