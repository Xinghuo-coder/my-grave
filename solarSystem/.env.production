# ========================================
# 生产环境配置文件
# ⚠️  请勿提交此文件到版本控制系统
# ========================================

# 服务器配置
NODE_ENV=production
PORT=8080

# 会话密钥（使用随机生成的强密钥）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION

# 前端URL（用于CORS配置）
FRONTEND_URL=https://your-frontend-domain.com

# ========================================
# Google Cloud SQL (MySQL) 配置
# ========================================
DB_HOST=/cloudsql/YOUR_PROJECT_ID:REGION:INSTANCE_NAME
# 或使用公网IP (不推荐): DB_HOST=XX.XX.XX.XX
DB_PORT=3306
DB_NAME=solar_system_db
DB_USER=solar_app_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# 连接池配置
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ========================================
# Google Secret Manager 配置
# ========================================
GCP_PROJECT_ID=your-gcp-project-id
USE_SECRET_MANAGER=true

# Secret Manager 中的密钥名称
SECRET_SESSION_KEY=session-secret
SECRET_DB_PASSWORD=db-password
SECRET_SMTP_PASSWORD=smtp-password
SECRET_SMS_API_KEY=sms-api-key

# ========================================
# 邮件服务配置 (Gmail SMTP 示例)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-app@gmail.com
SMTP_PASS=CHANGE_THIS_TO_APP_PASSWORD

# ========================================
# 短信服务配置 (Twilio 示例)
# ========================================
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_FROM_NUMBER=+1234567890

# ========================================
# 安全配置
# ========================================
# CORS 允许的源（多个用逗号分隔）
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie 配置
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=.your-domain.com

# ========================================
# 静态资源配置
# ========================================
# Google Cloud Storage 配置
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-gcp-project-id

# CDN 配置
CDN_URL=https://cdn.your-domain.com

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info
ENABLE_CLOUD_LOGGING=true

# ========================================
# 监控配置
# ========================================
ENABLE_MONITORING=true
ENABLE_ERROR_REPORTING=true
