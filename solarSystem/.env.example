# ========================================
# 开发环境配置文件示例
# 复制此文件为 .env 用于本地开发
# ========================================

# 服务器配置
PORT=3000
NODE_ENV=development

# 会话密钥（开发环境）
SESSION_SECRET=dev-solar-system-secret-key-2026

# 前端URL（用于CORS配置）
FRONTEND_URL=http://localhost:8095

# ========================================
# 数据库配置 - 开发环境使用 SQLite
# 生产环境请使用 MySQL 配置（见 .env.production）
# ========================================
DB_PATH=./server/database/users.db

# ========================================
# Google Cloud 配置（可选，开发环境不需要）
# ========================================
USE_SECRET_MANAGER=false
# GCP_PROJECT_ID=your-gcp-project-id

# ========================================
# 邮件服务配置（开发环境可选）
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ========================================
# 短信服务配置（开发环境可选）
# ========================================
# SMS_API_KEY=your-api-key
# SMS_API_SECRET=your-api-secret

# ========================================
# 安全配置
# ========================================
ALLOWED_ORIGINS=http://localhost:8095
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

